# Скопировать в .env.local и заполнить. .env.local в git не коммитится.

# Адрес бэкенда (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Подтверждённый публичный домен без пути: canonical, Open Graph, JSON-LD, sitemap.
# Локально localhost даёт noindex. Не переносите это значение в Vercel Production.
# На Vercel без этой переменной используется production-домен проекта.
# После покупки домена задайте https://ваш-домен.kz в Production и пересоберите.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно: true скрывает staging от индексации даже при настроенном домене.
# Vercel Preview и localhost получают noindex автоматически.
SITE_NOINDEX=false

# Необязательно: только значение content из google-site-verification.
GOOGLE_SITE_VERIFICATION=
