# Скопировать в .env и заполнить. .env в git не коммитится.

ENVIRONMENT=development
API_PREFIX=/api

# Адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:3000

# Локально — SQLite. На Vercel и в production требуется внешняя PostgreSQL.
DATABASE_URL=sqlite:///./guldar.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Ожидание подключения и свободного соединения, в секундах (1–30)
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_TIMEOUT=5

SECRET_KEY=change-me

# Уведомления о заявках в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
